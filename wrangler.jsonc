// Configuration du Worker Cloudflare : sert le site et le relais /api.
// Cloudflare l'utilise automatiquement quand le Worker est relié au dépôt GitHub.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "k2gpx",
  "main": "worker/komoot-proxy.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
